{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockradar.vn/schemas/radar-output.schema.json",
  "title": "StockRadar Radar Output",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "is_top5_hose",
    "is_mock",
    "snapshot",
    "gate",
    "market_regime",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {
      "enum": ["TOP5_HOSE", "INCOMPLETE_UNIVERSE", "SHORTLIST_FROM_AVAILABLE_DATA"]
    },
    "is_top5_hose": {"type": "boolean"},
    "is_mock": {"type": "boolean"},
    "market_regime": {"enum": ["GREEN", "YELLOW", "RED", "UNKNOWN"]},
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["rank", "ticker", "score", "setup", "state", "state_change"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 5},
          "ticker": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "score_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
          "state": {
            "enum": [
              "WATCH",
              "NEAR_TRIGGER",
              "READY",
              "TRIGGERED",
              "INVALIDATED",
              "EXTENDED",
              "EXPIRED"
            ]
          }
        }
      }
    }
  }
}

