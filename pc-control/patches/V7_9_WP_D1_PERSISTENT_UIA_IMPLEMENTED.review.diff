+"""Contract tests for the persistent UFO/UIA adapter. No real GUI input."""
+import pathlib,sys,unittest
+
+APP=pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(APP/'agent/src/engines/ufo'))
+import adapter
+
+class PersistentUfoContract(unittest.TestCase):
+    def _client(self,responses):
+        client=adapter._PersistentUfoWorker()
+        calls=[]
+        closes=[]
+        def request_once(payload,timeout):
+            calls.append((payload.get('action'),timeout))
+            return dict(responses.pop(0))
+        client._request_once_locked=request_once
+        client._close_locked=lambda:closes.append(True)
+        return client,calls,closes
+
+    def test_read_timeout_recycles_and_retries_once(self):
+        client,calls,closes=self._client([
+            {'ok':False,'error':'TIMEOUT','_request_flushed':True},
+            {'ok':True,'elements':[],'_request_flushed':True},
+        ])
+        result=client.request({'action':'inspect','selector':{'hwnd':1}},timeout=.1)
+        self.assertTrue(result['ok'])
+        self.assertEqual(len(calls),2)
+        self.assertEqual(len(closes),1)
+        self.assertNotIn('_request_flushed',result)
+
+    def test_mutation_timeout_never_replays(self):
+        client,calls,closes=self._client([
+            {'ok':False,'error':'TIMEOUT','_request_flushed':True},
+        ])
+        result=client.request({'action':'invoke_semantic','selector':{'hwnd':1}},timeout=.1)
+        self.assertFalse(result['ok'])
+        self.assertEqual(result['error'],'OUTCOME_UNKNOWN')
+        self.assertFalse(result['replay_safe'])
+        self.assertEqual(len(calls),1)
+        self.assertEqual(len(closes),0)
+
+    def test_mutation_failed_before_flush_is_not_unknown(self):
+        client,calls,_=self._client([
+            {'ok':False,'error':'UFO_WORKER_FAILED','_request_flushed':False},
+        ])
+        result=client.request({'action':'select','selector':{'hwnd':1}},timeout=.1)
+        self.assertFalse(result['ok'])
+        self.assertEqual(result['error'],'UFO_WORKER_FAILED')
+        self.assertEqual(len(calls),1)
+
+    def test_worker_environment_is_minimal(self):
+        env=adapter._worker_environment()
+        self.assertEqual(env['PYTHONNOUSERSITE'],'1')
+        self.assertEqual(env['PYTHONUTF8'],'1')
+        for key in env:
+            low=key.casefold()
+            self.assertNotIn('token',low)
+            self.assertNotIn('secret',low)
+            self.assertNotIn('proxy',low)
+
+if __name__=='__main__':
+    raise SystemExit(not unittest.main(verbosity=2,exit=False).result.wasSuccessful())
