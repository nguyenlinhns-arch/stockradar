+"""Bounded persistent out-of-process adapter around Microsoft's retained UFO² inspector.
+
+The worker is shared by semantic tasks to avoid paying Python/UFO/COM startup cost
+for every UIA read.  Requests are serialized deliberately: UIAutomation state is
+not thread-safe enough to justify parallel mutation, and V7 already serializes
+semantic side effects at a higher layer.
+
+Read-only requests may recycle the worker and retry once when the worker dies
+before a response.  Mutating requests are never automatically replayed after a
+request was flushed to the worker because the side effect may already have
+happened.
+"""
+import atexit,json,os,pathlib,queue,subprocess,sys,threading,uuid
+
+_READ_ACTIONS=frozenset({'inspect','find','get_value'})
+_CREATE_NO_WINDOW=0x08000000
+
+def _worker_environment():
+    # The UIA worker needs only a normal Windows/Python runtime plus the V7 data
+    # root for the host-authoritative /gui-input-check.  Do not pass proxy,
+    # credential, Python injection or arbitrary application environment.
+    allowed={
+        'SystemRoot','WINDIR','COMSPEC','PATH','PATHEXT','TEMP','TMP',
+        'LOCALAPPDATA','APPDATA','USERPROFILE','PROGRAMDATA',
+        'THAYLINH_DATA_ROOT',
+    }
+    allowed={k.casefold() for k in allowed}
+    env={k:v for k,v in os.environ.items() if k.casefold() in allowed}
+    env['PYTHONUTF8']='1'
+    env['PYTHONNOUSERSITE']='1'
+    return env
+
+class _PersistentUfoWorker:
+    def __init__(self):
+        self._lock=threading.RLock()
+        self._process=None
+        self._responses=queue.Queue()
+        self._reader=None
+
+    @staticmethod
+    def paths():
+        worker=pathlib.Path(__file__).with_name('worker.py').resolve()
+        python=pathlib.Path(sys.executable).with_name('python.exe').resolve()
+        return python,worker
+
+    def _reader_loop(self,process,responses):
+        try:
+            for line in process.stdout:
+                try:
+                    value=json.loads(line)
+                except (json.JSONDecodeError,TypeError):
+                    # stdout is protocol-only in our worker, but tolerate a
+                    # dependency writing one stray line without accepting it as
+                    # a result.
+                    continue
+                if isinstance(value,dict) and value.get('request_id'):
+                    responses.put(value)
+        finally:
+            responses.put({'_worker_eof':True})
+
+    def _start_locked(self):
+        if self._process and self._process.poll() is None:
+            return self._process
+        self._close_locked()
+        python,worker=self.paths()
+        self._responses=queue.Queue()
+        process=subprocess.Popen(
+            [str(python),str(worker),'--persistent'],
+            stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,
+            text=True,encoding='utf-8',errors='replace',bufsize=1,
+            creationflags=_CREATE_NO_WINDOW,env=_worker_environment(),
+        )
+        self._process=process
+        self._reader=threading.Thread(
+            target=self._reader_loop,args=(process,self._responses),
+            name='ThayLinh-UFO-stdout',daemon=True,
+        )
+        self._reader.start()
+        return process
+
+    def _close_locked(self):
+        process=self._process
+        self._process=None
+        if not process:
+            return
+        try:
+            if process.stdin:
+                process.stdin.close()
+        except Exception:
+            pass
+        try:
+            if process.poll() is None:
+                process.terminate()
+                process.wait(timeout=1.0)
+        except Exception:
+            try:process.kill()
+            except Exception:pass
+
+    def close(self):
+        with self._lock:
+            self._close_locked()
+
+    def _request_once_locked(self,payload,timeout):
+        process=self._start_locked()
+        request_id=str(uuid.uuid4())
+        body={**payload,'request_id':request_id}
+        try:
+            process.stdin.write(json.dumps(body,ensure_ascii=False,separators=(',',':'))+'\n')
+            process.stdin.flush()
+        except (BrokenPipeError,OSError,ValueError):
+            self._close_locked()
+            return {'ok':False,'error':'UFO_WORKER_FAILED','_request_flushed':False}
+        # From this point a mutating request may have crossed the side-effect
+        # boundary.  A missing response is uncertainty, never permission to
+        # replay the mutation.
+        while True:
+            try:
+                value=self._responses.get(timeout=timeout)
+            except queue.Empty:
+                self._close_locked()
+                return {'ok':False,'error':'TIMEOUT','_request_flushed':True}
+            if value.get('_worker_eof'):
+                self._close_locked()
+                return {'ok':False,'error':'UFO_WORKER_FAILED','_request_flushed':True}
+            if value.get('request_id')!=request_id:
+                # Requests are serialized; an unmatched id is a protocol fault.
+                self._close_locked()
+                return {'ok':False,'error':'UFO_WORKER_FAILED','_request_flushed':True}
+            result=dict(value)
+            result.pop('request_id',None)
+            result['_request_flushed']=True
+            return result
+
+    def request(self,payload,timeout=25):
+        action=payload.get('action')
+        read_only=action in _READ_ACTIONS
+        with self._lock:
+            first=self._request_once_locked(payload,timeout)
+            if first.get('ok'):
+                first.pop('_request_flushed',None)
+                return first
+            if read_only and first.get('error') in {'TIMEOUT','UFO_WORKER_FAILED'}:
+                # READ has no side effect, so one clean worker recycle/retry is
+                # safe and removes transient COM/worker startup failures.
+                self._close_locked()
+                second=self._request_once_locked(payload,timeout)
+                second.pop('_request_flushed',None)
+                return second
+            flushed=bool(first.pop('_request_flushed',False))
+            if not read_only and flushed and first.get('error') in {'TIMEOUT','UFO_WORKER_FAILED'}:
+                return {
+                    'ok':False,'error':'OUTCOME_UNKNOWN',
+                    'replay_safe':False,'method_used':'uia_persistent_worker',
+                }
+            return first
+
+_CLIENT=_PersistentUfoWorker()
+atexit.register(_CLIENT.close)
 
