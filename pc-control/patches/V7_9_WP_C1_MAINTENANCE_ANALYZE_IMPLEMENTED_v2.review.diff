+"""Headless C1 maintenance proposal contracts. No candidate code is executed."""
+import hashlib,json,pathlib,sys,tempfile,types,unittest
+APP=pathlib.Path(__file__).resolve().parents[1];sys.path.insert(0,str(APP/'agent'))
+from maintenance_service import analyze,status
+
+def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()
+
+class MaintenanceContract(unittest.TestCase):
+    def fixture(self,folder):
+        base=pathlib.Path(folder);source=base/'source';data=base/'install'/'data'
+        (source/'agent').mkdir(parents=True);(source/'scripts').mkdir();(source/'docs').mkdir();data.mkdir(parents=True)
+        (source/'agent/protocol_catalog.py').write_text('BASE=1\n');(source/'scripts/build_all.ps1').write_text("Write-Output 'build'\n")
+        (source/'VERSION.json').write_text('{"version":"7.9.0-rc1"}')
+        host=types.SimpleNamespace(ROOT=data,config=lambda:{'maintenance_source_root':str(source)})
+        return source,host
+    def write_patch(self,source,name,text):
+        path=source/'docs'/name;path.write_text(text,encoding='utf-8');return path
+    def test_analyze_does_not_mutate_source_and_persists_hashes(self):
+        with tempfile.TemporaryDirectory(prefix='maint-c1-') as folder:
+            source,host=self.fixture(folder);before=(source/'agent/protocol_catalog.py').read_bytes()
+            patch=self.write_patch(source,'one.diff','--- a/agent/protocol_catalog.py\n+++ b/agent/protocol_catalog.py\n@@\n-BASE=1\n+BASE=2\n')
+            result=analyze({'patch_path':str(patch),'expected_sha256':sha(patch)},host)
+            self.assertTrue(result['ok']);self.assertEqual(result['risk'],'TRUST_BOUNDARY');self.assertEqual((source/'agent/protocol_catalog.py').read_bytes(),before)
+            saved=list((host.ROOT.parent/'maintenance/proposals').glob('*.json'));self.assertEqual(len(saved),1)
+            value=json.loads(saved[0].read_text());self.assertEqual(value['patch_sha256'],sha(patch));self.assertEqual(len(value['base_manifest_sha256']),64)
+    def test_hash_mismatch_and_traversal_fail_closed(self):
+        with tempfile.TemporaryDirectory(prefix='maint-c1-') as folder:
+            source,host=self.fixture(folder);patch=self.write_patch(source,'bad.diff','--- a/agent/protocol_catalog.py\n+++ b/agent/protocol_catalog.py\n@@\n-A\n+B\n')
+            with self.assertRaisesRegex(ValueError,'PATCH_HASH_MISMATCH'):analyze({'patch_path':str(patch),'expected_sha256':'0'*64},host)
+            patch=self.write_patch(source,'escape.diff','--- a/agent/protocol_catalog.py\n+++ b/../escape.py\n@@\n-A\n+B\n')
+            with self.assertRaisesRegex(ValueError,'POLICY_DENIED|PATCH_RENAME_DENIED'):analyze({'patch_path':str(patch),'expected_sha256':sha(patch)},host)
+    def test_patch_must_be_direct_child_of_fixed_docs_inbox(self):
+        with tempfile.TemporaryDirectory(prefix='maint-c1-') as folder:
+            source,host=self.fixture(folder);nested=source/'docs/sub';nested.mkdir();patch=nested/'nested.diff';patch.write_text('--- a/agent/protocol_catalog.py\n+++ b/agent/protocol_catalog.py\n@@\n-A\n+B\n')
+            with self.assertRaisesRegex(ValueError,'PATCH_INBOX_REQUIRED'):analyze({'patch_path':str(patch),'expected_sha256':sha(patch)},host)
+    def test_status_is_bounded_and_source_path_is_not_disclosed(self):
