+            source,host=self.fixture(folder);value=status(host)
+            self.assertTrue(value['enabled']);self.assertEqual(value['phase'],'ANALYZE_ONLY');self.assertNotIn(str(source),json.dumps(value));self.assertLessEqual(len(value['proposals']),20)
+
+if __name__=='__main__':unittest.main(verbosity=2)
