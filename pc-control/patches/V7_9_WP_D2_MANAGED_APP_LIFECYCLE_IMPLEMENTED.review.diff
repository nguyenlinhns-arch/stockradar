+import pathlib,sys,tempfile,unittest
+
+APP=pathlib.Path(__file__).resolve().parents[1];sys.path.insert(0,str(APP/'agent'))
+from managed_apps import file_sha256,lifecycle_contract
+from managed_app_lifecycle import inspect,source_precondition
+
+class LifecycleContract(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory();self.root=pathlib.Path(self.temp.name)
+        self.exe=self.root/'App.exe';self.exe.write_bytes(b'exe')
+        self.src=self.root/'src'/'main.py';self.src.parent.mkdir();self.src.write_text('print(1)')
+        (self.root/'data').mkdir();(self.root/'config.json').write_text('{}')
+        self.cfg={'approved_executables':{str(self.exe):{
+            'sha256':file_sha256(self.exe),'arguments':[],'app_id':'fixture','profile_version':1,'adapter':'fixture',
+            'capabilities':['read','health'],'baseline_id':'base-1','app_root':str(self.root),
+            'managed_files':[{'path':'src/main.py','sha256':file_sha256(self.src),'role':'source'}],
+            'required_paths':['src','data'],'preserve':['data','config.json'],
+            'process':{'name':'Fixture.exe','max_instances':1,'ports':[]},
+        }}}
+    def tearDown(self):self.temp.cleanup()
+
+    def policy(self):return next(iter(self.cfg['approved_executables'].values()))
+
+    def test_ready_profile(self):
+        result=inspect('fixture',self.cfg)
+        self.assertTrue(result['ready']);self.assertEqual(result['state'],'READY')
+        self.assertEqual(result['preserve_count'],2)
+
+    def test_managed_file_drift_is_observed_not_repaired(self):
+        self.src.write_text('changed')
+        result=inspect('fixture',self.cfg)
+        self.assertFalse(result['ready']);self.assertEqual(result['state'],'MANAGED_FILE_DRIFT')
+        self.assertEqual(self.src.read_text(),'changed')
+
+    def test_preserve_overlap_rejected(self):
+        policy=dict(self.policy());policy['preserve']=['src/main.py']
+        with self.assertRaisesRegex(ValueError,'APP_PROFILE_PRESERVE_OVERLAP'):lifecycle_contract(policy)
+
+    def test_absolute_and_parent_paths_rejected(self):
+        for bad in ['../x','C:/Windows/x','/etc/passwd','\\\\server\\share']:
+            policy=dict(self.policy());policy['required_paths']=[bad]
+            with self.subTest(bad=bad),self.assertRaises(ValueError):lifecycle_contract(policy)
+
+    def test_expected_sha_fences_upgrade(self):
+        good=file_sha256(self.src)
+        self.assertTrue(source_precondition('fixture','src/main.py',good,self.cfg)['ok'])
+        self.src.write_text('newer')
+        with self.assertRaisesRegex(ValueError,'STATE_CHANGED'):source_precondition('fixture','src/main.py',good,self.cfg)
+
+    def test_manifest_never_changes_launch_authority(self):
+        policy=self.policy();policy['managed_files'].append({'path':'src/fake.exe','sha256':'0'*64,'role':'binary'})
+        contract=lifecycle_contract(policy)
+        self.assertIn('managed_files',contract)
+        self.assertNotIn('executable',contract)
+        self.assertNotIn('arguments',contract)
+
+if __name__=='__main__':
+    raise SystemExit(not unittest.main(verbosity=2,exit=False).result.wasSuccessful())
