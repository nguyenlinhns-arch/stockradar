+"""Read-only lifecycle diagnostics for locally approved ManagedApps.
+
+This is intentionally not an updater.  Repair/apply/rollback remains owned by
+V7 self-maintenance/TrustedUpdate after local approvals.  The module provides
+the Hub-style evidence those gates need: identity, managed-file drift, required
+paths, preserve boundaries, process counts and recovery state.
+"""
+import pathlib
+from managed_apps import file_sha256,lifecycle_contract,resolve,verify_file
+
+def _root(row):
+    policy=row['policy'];raw=policy.get('app_root')
+    root=pathlib.Path(raw).resolve() if raw else row['path'].parent.resolve()
+    if not root.is_absolute() or not root.is_dir():raise ValueError('APP_PROFILE_INVALID')
+    try:row['path'].resolve().relative_to(root)
+    except ValueError:raise ValueError('APP_PROFILE_INVALID')
+    return root
+
+def _under(root,relative):
+    value=(root/pathlib.PurePosixPath(relative)).resolve()
+    try:value.relative_to(root)
+    except ValueError:raise ValueError('APP_PROFILE_INVALID')
+    return value
+
+def inspect(app_id,cfg):
+    row=resolve(app_id,cfg);policy=row['policy'];contract=lifecycle_contract(policy);root=_root(row)
+    result={
+        'ok':True,'schema':'managed-app.lifecycle.v1','app_id':policy.get('app_id') or app_id,
+        'profile_version':contract.get('profile_version'),'adapter':contract.get('adapter'),
+        'baseline_id':contract.get('baseline_id'),'capabilities':contract.get('capabilities',[]),
+        'identity':'UNKNOWN','managed_files':[],'required_paths':[],'preserve_count':len(contract['preserve']),
+        'recovery_required':bool(policy.get('recovery_required',False)),
+    }
+    try:
+        verify_file(row['path'],policy.get('sha256'))
+        result['identity']='MATCH'
+    except ValueError as exc:
+        result['identity']='DRIFT';result['identity_error']=str(exc).split(':',1)[0]
+
+    drift=False
+    for item in contract['managed_files']:
+        path=_under(root,item['path']);exists=path.is_file();actual=file_sha256(path) if exists else None
+        match=exists and actual.casefold()==item['sha256'].casefold()
+        if not match:drift=True
+        result['managed_files'].append({'path':item['path'],'role':item['role'],'exists':exists,'match':match})
+
+    missing=False
+    for rel in contract['required_paths']:
+        exists=_under(root,rel).exists();missing|=not exists
+        result['required_paths'].append({'path':rel,'exists':exists})
+
+    process=contract.get('process') or {}
+    if process.get('name'):
+        try:
+            import psutil
+            count=0
+            for proc in psutil.process_iter(['name','exe']):
+                try:
+                    if str(proc.info.get('name') or '').casefold()==process['name'].casefold():count+=1
+                except (psutil.NoSuchProcess,psutil.AccessDenied):continue
+            result['process']={'name':process['name'],'count':count,'max_instances':process['max_instances'],'within_limit':count<=process['max_instances']}
+        except Exception:
+            result['process']={'name':process['name'],'state':'UNKNOWN'}
+
+    if result['recovery_required']:state='RECOVERY_REQUIRED'
+    elif result['identity']!='MATCH':state='IDENTITY_DRIFT'
+    elif drift:state='MANAGED_FILE_DRIFT'
+    elif missing:state='REQUIRED_PATH_MISSING'
+    elif isinstance(result.get('process'),dict) and result['process'].get('within_limit') is False:state='PROCESS_COUNT_INVALID'
+    else:state='READY'
+    result['state']=state;result['ready']=state=='READY'
+    return result
+
+def source_precondition(app_id,relative_path,expected_sha256,cfg):
+    """TOCTOU fence used before a separately-approved source upgrade."""
+    row=resolve(app_id,cfg);root=_root(row);contract=lifecycle_contract(row['policy'])
+    managed={x['path'].casefold():x for x in contract['managed_files']}
+    key=str(relative_path).replace('\\','/').casefold()
+    if key not in managed:raise ValueError('APP_FILE_NOT_MANAGED')
+    path=_under(root,managed[key]['path'])
+    if file_sha256(path).casefold()!=str(expected_sha256).casefold():raise ValueError('STATE_CHANGED')
+    return {'ok':True,'app_id':app_id,'path':managed[key]['path'],'sha256':str(expected_sha256).casefold()}
