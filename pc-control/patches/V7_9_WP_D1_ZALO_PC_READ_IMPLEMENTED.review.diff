+"""Shared local ManagedApp identity helpers.
+
+Profiles identify approved applications but never grant executable authority.
+The existing approved_executables policy remains the sole launch authority.
+"""
+import hashlib,pathlib,threading
+
+_HASH_CACHE={}
+_HASH_LOCK=threading.RLock()
+
+def file_sha256(path):
+    p=pathlib.Path(path)
+    stat=p.stat()
+    key=(str(p.resolve()).casefold(),stat.st_size,stat.st_mtime_ns,getattr(stat,'st_ctime_ns',0),getattr(stat,'st_ino',0))
+    with _HASH_LOCK:
+        cached=_HASH_CACHE.get(key)
+        if cached:return cached
+    h=hashlib.sha256()
+    with p.open('rb') as stream:
+        for block in iter(lambda:stream.read(1024*1024),b''):h.update(block)
+    value=h.hexdigest()
+    with _HASH_LOCK:
+        # Keep the cache bounded and automatically invalidated by size/mtime.
+        if len(_HASH_CACHE)>64:_HASH_CACHE.clear()
+        _HASH_CACHE[key]=value
+    return value
+
+def resolve(name,cfg):
+    matches=[]
+    for raw_path,raw_policy in cfg.get('approved_executables',{}).items():
+        policy=raw_policy if isinstance(raw_policy,dict) else {}
+        path=pathlib.Path(raw_path)
+        aliases={
+            path.stem.casefold(),path.name.casefold(),
+            str(policy.get('app_id','')).casefold(),
+            str(policy.get('name','')).casefold(),
+            *[str(v).casefold() for v in policy.get('aliases',[])],
+        }
+        if str(name).casefold() in aliases:matches.append((path,policy))
+    if not matches:raise ValueError('executable_not_locally_approved')
+    if len(matches)>1:raise ValueError('AMBIGUOUS_TARGET')
+    path,policy=matches[0]
+    return {'path':path,'policy':policy}
+
+def launch_recipe(name,cfg):
+    row=resolve(name,cfg);path=row['path'];policy=row['policy']
+    return {'executable':str(path),'args':policy.get('arguments',[]),**({'cwd':policy['cwd']} if policy.get('cwd') else {})}
+
+def verify_file(path,expected_sha256,changed_error='APP_BINARY_CHANGED'):
+    p=pathlib.Path(path)
+    if not p.is_absolute() or not p.is_file():raise ValueError('TARGET_NOT_FOUND')
+    if not expected_sha256 or file_sha256(p).casefold()!=str(expected_sha256).casefold():raise ValueError(changed_error)
+    return p
+
+def verify_launch_identity(name,cfg):
+    row=resolve(name,cfg);verify_file(row['path'],row['policy'].get('sha256'))
+    return row
