+"""Headless Zalo PC adapter contract tests. No real Zalo process or GUI input."""
+import hashlib,json,os,pathlib,sys,tempfile,types,unittest
+from unittest.mock import patch
+
+APP=pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(APP/'agent'))
+_observation=types.ModuleType('observation_store')
+_observation.state_hash=lambda state:hashlib.sha256(json.dumps(state,sort_keys=True,separators=(',',':'),default=str).encode()).hexdigest()
+sys.modules.setdefault('observation_store',_observation)
+
+import zalo_pc_service
+from managed_apps import file_sha256
+
+def digest(path):
+    return file_sha256(path)
+
+class FakeProcess:
+    def __init__(self,path):self.path=path
+    def exe(self):return str(self.path)
+
+class FakeEngine:
+    def __init__(self,window):self.window=window
+    def list_windows(self):return [self.window]
+
+class FakeHost:
+    def __init__(self,cfg):self._cfg=cfg
+    def config(self):return self._cfg
+
+class FakeSemantic:
+    def __init__(self,cfg,runtime):
+        self.host=FakeHost(cfg)
+        self.engine=FakeEngine({'hwnd':11,'pid':123,'process':'Zalo.exe','title':'Zalo','class_name':'Chrome_WidgetWin_1','rect':{'left':0,'top':0,'width':1000,'height':700}})
+        self.runtime=runtime
+    def snapshot(self,selector,with_ui=True):
+        state={'window':self.engine.window,'foreground_hwnd':11,'monitors':[],'desktop_geometry':{},'dpi_mode':'pmv2',
+               'ui_tree':[{'control_name':'Nguyễn Văn A','control_type':'ListItem','automation_id':'conversation-1'},
+                          {'control_name':'Xin chào','control_type':'Text','automation_id':'','value':'Xin chào'}]}
+        return {**selector,'hwnd':11,'pid':123,'process':'Zalo.exe'},state
+
+class ZaloPcContract(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory()
+        self.local=pathlib.Path(self.temp.name)
+        self.root=self.local/'Programs'/'Zalo';self.root.mkdir(parents=True)
+        self.launcher=self.root/'Zalo.exe';self.launcher.write_bytes(b'launcher')
+        self.version=self.root/'Zalo-26.8.20';self.version.mkdir()
+        self.runtime=self.version/'Zalo.exe';self.runtime.write_bytes(b'runtime-binary')
+        self.old=os.environ.get('LOCALAPPDATA');os.environ['LOCALAPPDATA']=str(self.local)
+
+    def tearDown(self):
+        if self.old is None:os.environ.pop('LOCALAPPDATA',None)
+        else:os.environ['LOCALAPPDATA']=self.old
+        self.temp.cleanup()
+
