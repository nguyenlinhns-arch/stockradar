+"""Read-first semantic adapter for the installed Windows Zalo PC application.
+
+Phase 1 intentionally excludes composing/sending messages.  It discovers the
+installed app, verifies locally approved launcher/runtime identities, and exposes
+bounded accessible UI state for ChatGPT planning.
+"""
+import os,pathlib,re
+from managed_apps import file_sha256,resolve,verify_file
+from observation_store import state_hash
+
+APP_ID='zalo-pc'
+_VERSION_RE=re.compile(r'^Zalo-(\d+(?:\.\d+){1,3})$',re.I)
+
+def _version_key(text):
+    try:return tuple(int(x) for x in str(text).split('.'))
+    except ValueError:return ()
+
+def _install_root():
+    base=os.environ.get('LOCALAPPDATA')
+    return pathlib.Path(base)/'Programs'/'Zalo' if base else None
+
+def discover_candidates():
+    root=_install_root()
+    if not root or not root.is_dir():return {'installed':False,'candidates':[]}
+    launcher=root/'Zalo.exe';found=[]
+    for child in root.iterdir():
+        if not child.is_dir():continue
+        match=_VERSION_RE.fullmatch(child.name);runtime=child/'Zalo.exe'
+        if match and runtime.is_file():found.append((match.group(1),runtime))
+    found.sort(key=lambda item:_version_key(item[0]),reverse=True)
+    rows=[{'version':version,'runtime_sha256':file_sha256(runtime),'runtime_size':runtime.stat().st_size}
+          for version,runtime in found[:5]]
+    value={'installed':bool(launcher.is_file() or found),'candidates':rows}
+    if launcher.is_file():
+        value['launcher_sha256']=file_sha256(launcher)
+        value['launcher_size']=launcher.stat().st_size
+    return value
+
+def _profile(cfg):
+    try:return resolve(APP_ID,cfg)
+    except ValueError as exc:
+        if str(exc)=='executable_not_locally_approved':return None
+        raise
+
+def _runtime_path(policy):
+    raw=policy.get('runtime_executable')
+    if not raw:raise ValueError('PROFILE_NOT_READY')
+    path=pathlib.Path(raw)
+    if not path.is_absolute():raise ValueError('PROFILE_NOT_READY')
+    return path
+
+def _verified_profile(cfg):
+    row=_profile(cfg)
+    if not row:raise ValueError('ZALO_PC_NOT_APPROVED')
+    policy=row['policy']
+    verify_file(row['path'],policy.get('sha256'))
+    runtime=_runtime_path(policy)
+    verify_file(runtime,policy.get('runtime_sha256'),'PROFILE_STALE')
+    root=row['path'].parent.resolve()
+    try:runtime.resolve().relative_to(root)
+    except ValueError:raise ValueError('PROFILE_STALE')
+    return row,runtime
+
+def _runtime_windows(semantic,runtime):
+    process_name=runtime.name.casefold()
+    rows=[]
+    for window in semantic.engine.list_windows():
+        if window.get('process','').casefold()!=process_name:continue
+        try:
+            import psutil
+            actual=pathlib.Path(psutil.Process(int(window['pid'])).exe()).resolve()
+        except Exception:
+            continue
+        if actual!=runtime.resolve():continue
+        rows.append(window)
+    return rows
+
+def _selector_from_profile(policy,runtime):
+    selector={'process':policy.get('process') or runtime.name}
+    if policy.get('window_title_regex'):selector['window_title_regex']=policy['window_title_regex']
+    if policy.get('window_class'):selector['window_class']=policy['window_class']
+    return selector
+
+def preflight_zalo(action,payload,host,cfg):
+    if action in {'zalo_snapshot','zalo_read_visible'}:
+        _verified_profile(cfg)
+    elif action=='zalo_status':
+        return
+    else:raise ValueError('TOOL_NOT_FOUND')
+
+def _status(semantic):
+    cfg=semantic.host.config();discovery=discover_candidates();row=_profile(cfg)
+    value={'ok':True,'schema':'zalo-pc.status.v1','installed':discovery['installed'],'approved':bool(row),
+           'candidates':discovery.get('candidates',[])[:3]}
+    if 'launcher_sha256' in discovery:value['launcher_sha256']=discovery['launcher_sha256']
+    if not row:
+        value.update(state='unapproved' if discovery['installed'] else 'not_installed',ready=False)
+        return value
+    policy=row['policy'];value['profile_version']=policy.get('profile_version')
+    try:
+        _,runtime=_verified_profile(cfg)
+    except ValueError as exc:
+        code=str(exc).split(':',1)[0]
+        value.update(state='profile_stale' if code in {'PROFILE_STALE','APP_BINARY_CHANGED'} else 'profile_not_ready',
+                     ready=False,error=code)
+        return value
+    windows=_runtime_windows(semantic,runtime)
+    value.update(
+        state='ready' if len(windows)==1 else 'not_running' if not windows else 'ambiguous_window',
+        ready=len(windows)==1,
+        runtime_version=policy.get('runtime_version'),
+        window_count=len(windows),
+    )
+    if len(windows)==1:
+        w=windows[0]
+        value['window']={k:w.get(k) for k in ('hwnd','pid','process','title','class_name','rect') if k in w}
+    return value
+
+def _snapshot(semantic,max_elements):
+    cfg=semantic.host.config();row,runtime=_verified_profile(cfg);policy=row['policy']
+    windows=_runtime_windows(semantic,runtime)
+    if len(windows)!=1:raise ValueError('TARGET_NOT_FOUND' if not windows else 'AMBIGUOUS_TARGET')
+    selector={'hwnd':windows[0]['hwnd'],**_selector_from_profile(policy,runtime)}
+    selected,state=semantic.snapshot(selector,True)
+    elements=state.get('ui_tree',[])[:max_elements]
+    compact_state={**state,'ui_tree':elements}
+    return {
+        'ok':True,'schema':'zalo-pc.state.v1',
+        'profile_version':policy.get('profile_version'),
+        'runtime_version':policy.get('runtime_version'),
+        'window':state['window'],'generation':state_hash(compact_state),
+        'elements':elements,'truncated':len(state.get('ui_tree',[]))>len(elements),
+        'selector':{'hwnd':selected['hwnd'],'process':selected.get('process')},
+    }
+
+def _read_visible(semantic,max_items):
+    snap=_snapshot(semantic,500);items=[]
+    for element in snap['elements']:
+        name=str(element.get('control_name') or '').strip()
+        value=str(element.get('value') or '').strip()
+        if not name and not value:continue
+        row={k:element.get(k) for k in ('control_type','automation_id','control_class','control_rect') if element.get(k) not in (None,'')}
+        if name:row['name']=name[:2000]
+        if value and value!=name:row['value']=value[:20000]
+        items.append(row)
+        if len(items)>=max_items:break
+    return {
+        'ok':True,'schema':'zalo-pc.visible.v1','window':snap['window'],
+        'generation':snap['generation'],'items':items,
+        'truncated':snap['truncated'] or len(items)>=max_items,
+        'completeness':'VISIBLE_VIEWPORT_ONLY',
+    }
+
+def execute_zalo(action,payload,semantic):
+    if action=='zalo_status':return _status(semantic)
+    if action=='zalo_snapshot':return _snapshot(semantic,payload.get('max_elements',200))
+    if action=='zalo_read_visible':return _read_visible(semantic,payload.get('max_items',100))
+    raise ValueError('TOOL_NOT_FOUND')
