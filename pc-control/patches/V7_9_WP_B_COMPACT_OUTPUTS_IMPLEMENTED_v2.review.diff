+def _public_error_code(value):
+    if value is None:return None
+    if isinstance(value,dict):return value.get('code') or value.get('error') or 'INTERNAL_ERROR'
+    return str(value)
+
+def compact_task_status(value):
+    """Bound durable task status without hiding uncertainty or failure state."""
+    result=value.get('result')
+    compact_result=None
+    if isinstance(result,dict):
+        keys=('ok','verified','action','task_id','planner','duration_ms','completed_at','cancellation','outcome','can_resume','result_mode')
+        compact_result={k:result[k] for k in keys if k in result}
+        error=_public_error_code(result.get('error'))
+        if error is not None:compact_result['error_code']=error
+        # A workflow result may duplicate every step. The journal below is the
+        # durable source for step state, so omit nested result.steps in summary.
+    elif result is not None:
+        compact_result=result
+    steps=[]
+    for row in value.get('steps',[]):
+        if not isinstance(row,dict):continue
+        step_result=row.get('result')
+        error=step_result.get('error') if isinstance(step_result,dict) else None
+        if error is None:error=row.get('error')
+        item={k:row[k] for k in ('index','command','status') if k in row}
+        code=_public_error_code(error)
+        if code is not None:item['error_code']=code
+        if isinstance(step_result,dict):
+            if 'ok' in step_result:item['ok']=bool(step_result.get('ok'))
+            if 'verified' in step_result:item['verified']=bool(step_result.get('verified'))
+        steps.append(item)
+    return {k:v for k,v in value.items() if k not in {'result','steps'}}|{'result':compact_result,'steps':steps}
