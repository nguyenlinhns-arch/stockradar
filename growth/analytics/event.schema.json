{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StockRadar analytics event",
  "type": "object",
  "required": ["event_name", "occurred_at", "session_id", "page", "proposition"],
  "properties": {
    "event_name": {"enum": ["ad_click", "landing_view", "radar_view", "top5_expand", "track_record_view", "signup_started", "signup_completed", "alert_opt_in", "pro_page_view", "trial_started", "subscription_started", "return_d1", "return_d7"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "page": {"type": "string", "maxLength": 200},
    "proposition": {"enum": ["radar5", "breakout", "risk", "organic"]},
    "utm": {"type": "object"},
    "properties": {"type": "object"}
  },
  "additionalProperties": false
}

