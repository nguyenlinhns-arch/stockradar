    "event_name": {"enum": ["top_view", "horizon_change", "sector_view", "recommendation_list_view", "recommendation_public_view", "recommendation_history_view", "performance_view", "benchmark_view", "today_changes_view", "four_horizon_view", "holding_view", "stock_search", "ticker_search", "ticker_input_started", "ticker_autocomplete_selected", "ticker_search_submitted", "ticker_search_valid", "ticker_search_invalid", "ticker_cache_hit", "ticker_cache_miss", "quick_report_view", "full_report_requested", "report_generation_completed", "report_generation_failed", "ticker_trial_cta_clicked", "ticker_watch_started", "onboarding_horizon_selected", "onboarding_sector_selected", "onboarding_ticker_added", "paid_email_preference_changed", "sample_premium_report_view", "signup_start", "signup_complete", "pro_view", "checkout_start", "payment_complete", "email_open", "email_click", "renewal_complete", "ad_click", "landing_view", "radar_view", "top5_expand", "track_record_view", "knowledge_view", "method_view", "horizon_select", "signup_started", "signup_completed", "alert_opt_in", "pro_page_view", "trial_started", "subscription_started", "return_d1", "return_d7"]},
